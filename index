<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>prod.c00lkid player</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#15121f; --panel:#1e1a2e; --line:#352e4f; --text:#efeaff; --mute:#9a90bd;
    --hot:#ff3d81; --ice:#3de0ff;
  }
  *{box-sizing:border-box;margin:0}
  html,body{height:100%}
  body{
    background:var(--bg);color:var(--text);
    font-family:"Space Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
    display:flex;align-items:center;justify-content:center;padding:20px;
  }
  .deck{width:100%;max-width:880px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;position:relative;overflow:hidden}
  .deck.drag{outline:2px dashed var(--ice);outline-offset:-8px}
  header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}
  h1{font-size:clamp(1.3rem,4vw,1.9rem);font-weight:700;letter-spacing:-.02em;line-height:1.1;word-break:break-word}
  .sub{color:var(--mute);font-size:.85rem;margin-top:6px}
  .load{flex:none;background:transparent;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:9px 14px;font:inherit;font-size:.9rem;cursor:pointer}
  .load:hover{border-color:var(--ice);color:var(--ice)}
  canvas{display:block;width:100%;border-radius:8px}
  #viz{height:200px;background:#110e1b;margin-bottom:12px}
  #wave{height:84px;background:#110e1b;cursor:pointer;margin-bottom:14px}
  .bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  #play{width:54px;height:54px;border-radius:50%;border:0;background:var(--hot);color:#fff;cursor:pointer;display:grid;place-items:center}
  #play:hover{filter:brightness(1.1)}
  #play svg{width:22px;height:22px;fill:currentColor}
  .time{font-variant-numeric:tabular-nums;color:var(--mute);font-size:.9rem;min-width:96px}
  .toggle{background:transparent;border:1px solid var(--line);color:var(--mute);border-radius:8px;padding:8px 12px;font:inherit;font-size:.85rem;cursor:pointer}
  .toggle[aria-pressed="true"]{border-color:var(--hot);color:var(--hot)}
  .vol{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--mute);font-size:.85rem}
  input[type=range]{accent-color:var(--ice);width:110px}
  button:focus-visible,input:focus-visible{outline:2px solid var(--ice);outline-offset:2px}
  .hint{margin-top:14px;color:var(--mute);font-size:.8rem}
  @media (max-width:520px){.vol{margin-left:0;width:100%}}
</style>
</head>
<body>
<main class="deck" id="deck">
  <header>
    <div>
      <h1 id="title">project</h1>
      <p class="sub" id="sub">Loaded: your beat. Drop in another file to swap it.</p>
    </div>
    <button class="load" id="loadBtn" type="button">Upload a song</button>
    <input type="file" id="file" accept="audio/*" hidden>
  </header>

  <canvas id="viz"></canvas>
  <canvas id="wave" aria-label="Waveform. Click to seek."></canvas>

  <div class="bar">
    <button id="play" type="button" aria-label="Play"><svg viewBox="0 0 24 24" id="icon"><path d="M7 4v16l13-8z"/></svg></button>
    <span class="time" id="time">0:00 / 0:00</span>
    <button class="toggle" id="loop" type="button" aria-pressed="false">Loop</button>
    <label class="vol">Volume <input type="range" id="vol" min="0" max="1" step="0.01" value="0.9"></label>
  </div>
  <p class="hint">Drag and drop an audio file anywhere on this card. Space bar plays and pauses.</p>
</main>

<audio id="audio" preload="auto"></audio>

<script>
const DEFAULT_NAME = "project";
const DEFAULT_B64 = "";

const $ = id => document.getElementById(id);
const audio = $('audio'), viz = $('viz'), wave = $('wave');
let ctx, analyser, srcNode, peaks = null, url = null, raf;

function b64ToBuf(b64){
  const bin = atob(b64), n = bin.length, u = new Uint8Array(n);
  for(let i=0;i<n;i++) u[i]=bin.charCodeAt(i);
  return u.buffer;
}
function fmt(t){ if(!isFinite(t)) t=0; const m=Math.floor(t/60), s=Math.floor(t%60); return m+":"+String(s).padStart(2,'0'); }

function setupAudioGraph(){
  if(ctx) return;
  ctx = new (window.AudioContext||window.webkitAudioContext)();
  analyser = ctx.createAnalyser();
  analyser.fftSize = 512;
  analyser.smoothingTimeConstant = 0.78;
  srcNode = ctx.createMediaElementSource(audio);
  srcNode.connect(analyser); analyser.connect(ctx.destination);
}

async function loadBlob(blob, name){
  if(url) URL.revokeObjectURL(url);
  url = URL.createObjectURL(blob);
  audio.src = url;
  $('title').textContent = name.replace(/\.[^.]+$/,'');
  $('sub').textContent = name;
  setPlayIcon(false);
  peaks = null; drawWave();
  try{
    const ac = new (window.AudioContext||window.webkitAudioContext)();
    const buf = await ac.decodeAudioData(await blob.arrayBuffer());
    ac.close();
    const ch = buf.getChannelData(0), N = 900, step = Math.floor(ch.length/N) || 1;
    peaks = new Float32Array(N);
    for(let i=0;i<N;i++){ let m=0; for(let j=0;j<step;j++){ const v=Math.abs(ch[i*step+j]||0); if(v>m)m=v; } peaks[i]=m; }
  }catch(e){ peaks = null; }
  drawWave();
}

function sizeCanvas(c){
  const r = c.getBoundingClientRect(), d = window.devicePixelRatio||1;
  if(c.width!==Math.round(r.width*d)){ c.width=Math.round(r.width*d); c.height=Math.round(r.height*d); }
  return d;
}

function drawWave(){
  sizeCanvas(wave);
  const g = wave.getContext('2d'), W=wave.width, H=wave.height;
  g.clearRect(0,0,W,H);
  const prog = audio.duration ? audio.currentTime/audio.duration : 0;
  if(!peaks){ g.fillStyle='#352e4f'; g.fillRect(0,H/2-1,W,2); return; }
  const n = peaks.length, bw = W/n;
  for(let i=0;i<n;i++){
    const h = Math.max(2, peaks[i]*H*0.92);
    g.fillStyle = (i/n)<prog ? '#ff3d81' : '#4a4170';
    g.fillRect(i*bw, (H-h)/2, Math.max(1,bw-1), h);
  }
}

function drawViz(){
  raf = requestAnimationFrame(drawViz);
  sizeCanvas(viz);
  const g = viz.getContext('2d'), W=viz.width, H=viz.height;
  g.clearRect(0,0,W,H);
  const bars = 48, bw = W/bars;
  let data = null;
  if(analyser){ data = new Uint8Array(analyser.frequencyBinCount); analyser.getByteFrequencyData(data); }
  const grad = g.createLinearGradient(0,H,0,0);
  grad.addColorStop(0,'#ff3d81'); grad.addColorStop(1,'#3de0ff');
  g.fillStyle = grad;
  for(let i=0;i<bars;i++){
    const idx = Math.floor(Math.pow(i/bars,1.6)*(analyser?analyser.frequencyBinCount*0.8:1));
    const v = data ? data[idx]/255 : 0;
    const h = Math.max(3, v*H*0.95);
    g.fillRect(i*bw+2, H-h, bw-4, h);
  }
  drawWave();
  $('time').textContent = fmt(audio.currentTime)+" / "+fmt(audio.duration);
}

function setPlayIcon(playing){
  $('icon').innerHTML = playing ? '<path d="M6 4h4v16H6zM14 4h4v16h-4z"/>' : '<path d="M7 4v16l13-8z"/>';
  $('play').setAttribute('aria-label', playing?'Pause':'Play');
}
async function toggle(){
  setupAudioGraph();
  if(ctx.state==='suspended') await ctx.resume();
  if(audio.paused) audio.play(); else audio.pause();
}

$('play').onclick = toggle;
audio.onplay = ()=>setPlayIcon(true);
audio.onpause = ()=>setPlayIcon(false);
audio.onended = ()=>setPlayIcon(false);
$('loop').onclick = e=>{ audio.loop=!audio.loop; e.currentTarget.setAttribute('aria-pressed',audio.loop); };
$('vol').oninput = e=>{ audio.volume = +e.target.value; };
audio.volume = 0.9;
wave.onclick = e=>{
  if(!audio.duration) return;
  const r = wave.getBoundingClientRect();
  audio.currentTime = ((e.clientX-r.left)/r.width)*audio.duration;
};
document.addEventListener('keydown', e=>{
  if(e.code==='Space' && e.target.tagName!=='INPUT'){ e.preventDefault(); toggle(); }
});

$('loadBtn').onclick = ()=>$('file').click();
$('file').onchange = e=>{ const f=e.target.files[0]; if(f) loadBlob(f, f.name); };
const deck = $('deck');
['dragenter','dragover'].forEach(t=>deck.addEventListener(t,e=>{e.preventDefault();deck.classList.add('drag');}));
['dragleave','drop'].forEach(t=>deck.addEventListener(t,e=>{e.preventDefault();deck.classList.remove('drag');}));
deck.addEventListener('drop',e=>{
  const f=e.dataTransfer.files[0];
  if(f && f.type.startsWith('audio')) loadBlob(f,f.name);
});

window.addEventListener('resize', drawWave);
loadBlob(new Blob([b64ToBuf(DEFAULT_B64)],{type:'audio/mpeg'}), DEFAULT_NAME+".mp3");
drawViz();
</script>
</body>
</html>
